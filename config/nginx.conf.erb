# nginx in front of unicorn for the RAILS_SERVER=unicorn-nginx benchmark
# target. bin/server renders this into tmp/nginx-<port>/nginx.conf and runs
# nginx in the foreground next to unicorn.
#
# The load generator keeps its keep-alive connections open to nginx, and nginx
# hands each request to unicorn over a Unix socket. Unicorn closes the upstream
# connection after every response, so each request goes to whichever worker
# is free next.

daemon off;
worker_processes <%= nginx_workers %>;
pid <%= dir %>/nginx.pid;
error_log stderr warn;

events {
  worker_connections 4096;
}

http {
  access_log off;

  # nginx writes request bodies and large responses here.
  client_body_temp_path <%= dir %>/client_body;
  proxy_temp_path <%= dir %>/proxy;
  fastcgi_temp_path <%= dir %>/fastcgi;
  uwsgi_temp_path <%= dir %>/uwsgi;
  scgi_temp_path <%= dir %>/scgi;

  upstream unicorn {
    # fail_timeout=0: a refused connection (all workers busy, backlog full)
    # never marks the only upstream as down.
    server unix:<%= socket %> fail_timeout=0;
  }

  server {
    listen <%= bind %>:<%= port %> backlog=1024;

    # Never close the client's keep-alive connections during a run.
    keepalive_requests 10000000;
    keepalive_timeout 75s;
    tcp_nodelay on;

    location / {
      proxy_pass http://unicorn;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      # Buffer whole responses so a worker is freed as soon as it has
      # written its response, without waiting for the client to read it.
      proxy_buffering on;
      proxy_buffers 16 16k;
      proxy_buffer_size 16k;
      # Rails pages here are ~38 KiB; keep them out of the temp files.
      proxy_max_temp_file_size 0;
      proxy_read_timeout <%= read_timeout %>s;
    }
  }
}
