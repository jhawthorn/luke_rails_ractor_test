<?xml version="1.0" encoding="UTF-8"?>
<%# Same document atom_feed builds, without Builder: Builder's method_missing
    defines methods on the singleton class of each XmlMarkup it renders, and
    every define_method clears method caches under a VM barrier. The Builder
    version is in builder_disabled/. %>
<feed xml:lang="en-US" xmlns="http://www.w3.org/2005/Atom">
  <id>tag:<%= request.host %>,2005:<%= request.fullpath.split(".").first %></id>
  <link rel="alternate" type="text/html" href="<%= root_url %>"/>
  <link rel="self" type="application/atom+xml" href="<%= request.url %>"/>
  <title>Ractor Blog</title>
  <updated><%= (@posts.first&.published_at || Time.now.utc).xmlschema %></updated>
<% @posts.each do |post| %>
  <entry>
    <id>tag:<%= request.host %>,2005:Post/<%= post.id %></id>
    <published><%= post.published_at.xmlschema %></published>
    <updated><%= post.updated_at.xmlschema %></updated>
    <link rel="alternate" type="text/html" href="<%= post_url(post) %>"/>
    <title><%= post.title %></title>
    <summary><%= post.excerpt(300) %></summary>
    <content type="html"><%= String.new(post.rendered.html) %></content>
    <author>
      <name><%= post.author&.name || "Anonymous" %></name>
    </author>
<% post.tags.each do |t| %>
    <category term="<%= t.name %>"/>
<% end %>
  </entry>
<% end %>
</feed>
