atom_feed(root_url: root_url) do |feed|
  feed.title "Ractor Blog"
  feed.updated @posts.first&.published_at

  @posts.each do |post|
    feed.entry(post, published: post.published_at, updated: post.updated_at) do |entry|
      entry.title post.title
      entry.summary post.excerpt(300)
      entry.content post.rendered.html, type: "html"
      entry.author { |author| author.name post.author&.name || "Anonymous" }
      post.tags.each { |t| entry.category term: t.name }
    end
  end
end
