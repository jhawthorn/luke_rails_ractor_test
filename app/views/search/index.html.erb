<% content_for :title, @query.present? ? "Search: #{@query}" : "Search" %>
<h1>Search</h1>
<%= form_with url: search_path, method: :get, local: true do |f| %>
  <%= f.search_field :q, value: @query, placeholder: "ractor gc", size: 40 %>
  <%= f.submit "Search", name: nil %>
<% end %>

<% if @terms.any? %>
  <p class="muted"><%= pluralize(@total, "match") %> for <%= @terms.map { tag.code(it) }.to_sentence.html_safe %>
    <%= "(showing the best 20)" if @total > 20 %></p>
  <% @results.each do |r| %>
    <article class="card">
      <h2><%= link_to r[:post].title, r[:post] %> <span class="muted">score <%= r[:score] %></span></h2>
      <div class="meta"><%= byline(r[:post]) %></div>
      <p><%= r[:snippet].to_html %></p>
      <div><%= tag_chips(r[:post].tags) %></div>
    </article>
  <% end %>
<% end %>
